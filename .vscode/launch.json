{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Pico Debug (RP2040)",
            "type": "cortex-debug",
            "request": "launch",

            "cwd": "${workspaceFolder}",
            "executable": "C:/msc_file_explorer/build/pico-release/app/app_main.elf",

            "servertype": "openocd",
            "serverpath": "C:/openocd/bin/openocd.exe",

            "device": "RP2040",

            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/rp2040.cfg"
            ],

            "serverArgs": [
                "-s", "C:/openocd/share/openocd/scripts",
                "-c", "adapter speed 5000"
            ],

            "runToEntryPoint": "main",

            "gdbPath": "C:/arm-none-eabi/bin/arm-none-eabi-gdb.exe",

            "svdFile": "C:/pico-sdk/src/rp2040/hardware_regs/rp2040.svd",

            "gdbTarget": "localhost:50000",

            "postLaunchCommands": [
                "monitor reset halt"
            ],

            "showDevDebugOutput": "raw"
        }
    ]
}