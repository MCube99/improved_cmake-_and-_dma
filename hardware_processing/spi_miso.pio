.pio_version 0
.program spi_miso

public keyboard_miso_entry:

wait_csn:
    mov osr, null
    irq wait 1
    pull ifempty block              ; get first TX word. No idea when this happens
    mov x, osr
    wait 1 gpio 4
    wait 0 gpio 4
    jmp check_chip_select
    

.wrap_target
bitloop:
    wait 0 gpio 3            ; SCLK low
    out pins, 1             ; put next MISO bit on bus
    wait 1 gpio 3            ; rising edge → master samples
check_chip_select:
    irq wait 7
    jmp bitloop
.wrap


% c-sdk {
#include "hardware/gpio.h"    
static inline void spi_miso_program_init(PIO pio, uint sm, uint offset, uint sclk_uint csn_pin, uint tx_pin)
{
   pio_sm_config c = spi_miso_program_get_default_config(offset);
    sm_config_set_in_pins(&c, sclk_pin );
    sm_config_set_out_pins(&c, tx_pin , 1);
    sm_config_set_out_shift(&c, false, false,8); // MSB first
    sm_config_set_jmp_pin(&c,csn_pin);
    pio_sm_set_consecutive_pindirs(pio,sm,tx_pin,1,true);
    pio_gpio_init(pio, tx_pin);
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}
