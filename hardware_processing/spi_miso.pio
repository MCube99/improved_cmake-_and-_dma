.pio_version 0
.program spi_miso

public keyboard_miso_entry:

.wrap_target
wait_csn:
    pull block
    wait 1 gpio 4 ; waits for a clean spi transaction
    wait 0 gpio 4
    
bitloop:
    wait 0 gpio 3            ; SCLK low
    out pins, 1             ; put next MISO bit on bus
    wait 1 gpio 3            ; rising edge → master samples
    jmp !osre bitloop
    out null, 32        ; Empty out the osr via this(discard bits)
.wrap


% c-sdk {
#include "hardware/gpio.h"    
static inline void spi_miso_program_init(PIO pio, uint sm, uint offset, uint csn_pin, uint tx_pin)
{
    pio_sm_config c = spi_miso_program_get_default_config(offset);
    sm_config_set_out_pins(&c, tx_pin , 1);
    sm_config_set_out_shift(&c, false, false,8); // MSB first 
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);
    sm_config_set_jmp_pin(&c,csn_pin);
    pio_sm_set_consecutive_pindirs(pio,sm,tx_pin,1,true);
    pio_gpio_init(pio, tx_pin);
    pio_sm_set_pindirs_with_mask64( pio, sm, (1ull << tx_pin), (1ull << tx_pin));
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}
