.pio_version 0

.program clocked_input

.define public USB_KEY 0x1F

initial_setup:
    irq wait 0

constant_sets:
    set y, USB_KEY
    set x, 8

get_size_byte:
    wait 0 pin 1
    wait 1 pin 1             
    in pins, 1;             
    jmp x--, get_size_byte 
    push 
    jmp pin determine_usb_or_keyboard 

determine_usb_or_keyboard:
    irq wait 1
    pull block 
    mov y, osr               ; Via autipull pulls it from pio sm put and then move it here to x for comparison
    jmp x!=y keyboard_setup   ; If not 0x1F then go to usb 
    jmp usb_setup

usb_setup:
    irq wait 2

usb_processing:
    wait 0 pin 1           ; a do while loop of sorts, it keeps 
    wait 1 pin 1
    in pins, 1             ; Shifts bit count bits from source into the INPUT SHIFT REGISTER 
    push iffull noblock            ; pushes bits from isr to RXFIFO. Does this every byte
    jmp pin initial_setup  ; warning to jmp to initial setup if csn goes high
    jmp usb_processing

.wrap_target
keyboard_setup:
    pull block
    mov x, osr              ; should be 0x0F because I am putting 0x0F in here via sm_put
    jmp x!=y initial_setup ; if not 0x0F, then

keyboard_processing: 
    set x, 7               ; for every clock cycle
    wait 0 pin 1
    wait 1 pin 1
    out pins, 1
    jmp x-- keyboard_processing

.wrap

% c-sdk {

static inline void clocked_input_program_init(PIO pio, uint sm, uint offset, uint pin) {
    pio_sm_config c = clocked_input_program_get_default_config(offset);

    // Recieving pin master to slave/Gary to a brown man
    sm_config_set_in_pins(&c, pin);  // reading data from the in pin(TX PIN) and use this to fill the isr. 
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 3, false); // Sets it as input. This is for all the pins listed above
    sm_config_set_in_shift(&c,false,false, 8); // keeps an eye on the data shifted into the isr, and once the threshold is reached(a byte) it outputs it to the RXFIFO 
    sm_config_set_jmp_pin(&c, pin + 2); // csn pin and it jumps high

    // pin      = data    1
    // pin + 1  = clock   2
    // pin + 2  = CSN     3




    // TX pin outputting when the csn goes low and when its time. This is for the keyboard 
    sm_config_set_out_pins(&c, pin + 3, 1);
    pio_sm_set_consecutive_pindirs(pio, sm, pin + 3, 1, true);
    sm_config_set_out_shift(&c,true,false, 8);

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);

}

