.pio_version 0
.program clocked_input

flush:
    mov isr, null         ; Clear ISR and input shift counter
    out null, 32

.wrap_target
do_bit:
    wait 0 pin 1          ; will literally be the first serial clock to come in. Don't need csn check here
    wait 1 pin 1         ; wait for the first edge to sample data 
    in pins, 1            ; samples it in via autofull
check_chip_select:        
    jmp pin flush       ; will go back to flush if pic is still high
.wrap

% c-sdk {

static inline void clocked_input_program_init(PIO pio, uint sm, uint offset, uint pin, uint jmp_pin) {
    pio_sm_config c = clocked_input_program_get_default_config(offset);
    sm_config_set_in_pins(&c,pin);
    sm_config_set_jmp_pin(&c, jmp_pin);
    sm_config_set_in_shift(&c,false,true, 8);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_RX);
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio,sm,true);
}

%}