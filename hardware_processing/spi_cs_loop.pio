.pio_version 0
.program spi_cs_loop

.wrap_target

wait 1 pin 0
wait 0 pin 1 
irq clear 7
set pins,1 [15]
set pins, 0 [15]

.wrap 

% c-sdk {
static inline void spi_cs_loop_init(PIO pio, uint sm, uint offset, uint cs_pin, uint debug_pin) {
    pio_sm_config c = spi_cs_loop_program_get_default_config(offset);
    pio_gpio_init(pio, debug_pin);
    sm_config_set_in_pins(&c, cs_pin);
    sm_config_set_set_pins(&c, debug_pin,1);
    pio_sm_set_consecutive_pindirs(pio, sm, debug_pin, 1, true);
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}