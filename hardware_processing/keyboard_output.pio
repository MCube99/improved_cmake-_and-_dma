.pio_version 0
.program keyboard_output
.side_set 1 opt
keyboard_init:
    irq wait 1
    set pindirs, 1
.wrap_target
keyboard_setup:
    pull block
    irq wait 7
    set pins, 1
    out pins, 1
bitloop:
    wait 1 gpio 3 side 0
    in pins, 1     
    wait 0 gpio 3 side 1
    out pins, 1    
    jmp !osre miso_output
.wrap
miso_output:
    push iffull noblock  
    set pins, 0
    jmp keyboard_setup
% c-sdk {
#include "hardware/gpio.h"    
static inline void keyboard_output_program_init(PIO pio, uint sm, uint offset, uint rx_pin, uint debug_pins)
{
    pio_sm_config c = keyboard_output_program_get_default_config(offset);
    sm_config_set_in_pins(&c, rx_pin);
    sm_config_set_in_shift(&c, false, false, 8);
    sm_config_set_out_pins(&c, rx_pin+3, 1);
    sm_config_set_out_shift(&c, false, false, 8);
    sm_config_set_set_pins(&c, debug_pins, 1);
    sm_config_set_sideset_pins(&c, debug_pins+1);
    pio_sm_init(pio, sm, offset, &c);
    pio_gpio_init(pio,rx_pin);


    pio_sm_set_enabled(pio, sm, true);
}
%}
