.pio_version 0
.program keyboard_output
keyboard_init:
    irq wait 1 ;will only be cleared everytime a character is put in
    set pindirs, 1

keyboard_setup:
    pull block ; blocks if empty and txfifo is empty
    irq clear 7 ; clear out the interrupt for the other sm
    wait 0 pin 0
    jmp check_csn_select
.wrap_target
bitloop:
    out pins, 1 ; ouput immediately before clock even starts 
    wait 1 pin 0 ; wait for serial clock to go high
    set pins, 1
    wait 0 pin 0 ; wait for it to go low
    set pins, 0
    out pins, 1    ; push a bit out
check_csn_select:
    jmp pin, keyboard_setup
.wrap


% c-sdk {
#include "hardware/gpio.h"    
static inline void keyboard_output_program_init(PIO pio, uint sm, uint offset, uint sclk_pin, uint csn_pin, uint debug_keyboard)
{
    pio_sm_config c = keyboard_output_program_get_default_config(offset);
    sm_config_set_in_pins(&c, sclk_pin); // this is the MOSI pin.
    sm_config_set_out_pins(&c, sclk_pin+2, 1);
    sm_config_set_set_pins(&c, debug_keyboard,1);
    sm_config_set_out_shift(&c, false, false, 8); // WILL block if no data // is available, and only work if there is data coming in from keyboard
    sm_config_set_jmp_pin(&c,csn_pin);
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}
