.pio_version 0
.program spi_miso_loop

keyboard_init:
    irq wait 1 

public keyboard_miso_entry:
keyboard_setup:
    pull block  ; blocks if empty and txfifo is empty
    irq wait 2
    irq clear 7  
    jmp check_csn_select
    
.wrap_target
bitloop:
    wait 0 pin 0 
    out pins, 1  
    wait 1 pin 0 
check_csn_select:
    jmp pin, keyboard_setup
.wrap


% c-sdk {
#include "hardware/gpio.h"    
static inline void spi_miso_loop_program_init(PIO pio, uint sm, uint offset, uint sclk_pin, uint csn_pin, uint debug_miso, uint tx_pin)
{
   pio_sm_config c = spi_miso_loop_program_get_default_config(offset);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);
    sm_config_set_in_pins(&c, sclk_pin); // this is the MOSI pin.
    sm_config_set_out_pins(&c, tx_pin , 1);
    sm_config_set_set_pins(&c, debug_miso,1);
    sm_config_set_out_shift(&c, false, false, 8); // MSB first
    sm_config_set_jmp_pin(&c,csn_pin);
    pio_sm_set_pins_with_mask(pio, sm, 0, (1u << tx_pin)|(1u << debug_miso));
    pio_sm_set_pindirs_with_mask(pio, sm, (1u << tx_pin)|(1u << debug_miso), (1u << tx_pin)|(1u << debug_miso));
    pio_gpio_init(pio, tx_pin);
    pio_gpio_init(pio, debug_miso);
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}
