.pio_version 0 // only requires PIO version 0

.program keyboard_input



setup:
    set x, 8 
    wait 0 pin 2 //csn pin 



output_data:
    irq wait 1 ; should start the  on. This is good because it takes advantage of the length of time between csn and the first inputs
    wait 0 pin 0
    wait 1 pin 0
    jmp x--,data_push
    irq wait 3
    jmp pin setup


data_push:
    out pins, 1
    jmp output_data

% c-sdk {
static inline void keyboard_input_program_init(PIO pio, uint sm, uint offset, uint data_out_pin, uint clock_pin, uint jump_pin) {
    pio_sm_config c = keyboard_input_program_get_default_config(offset);

    pio_sm_set_consecutive_pindirs(pio, sm, clock_pin, 2, false); //sets input pin 
    pio_sm_set_consecutive_pindirs(pio, sm, data_out_pin, 1, true); // sets output pin 

    sm_config_set_in_pins(&c, clock_pin);   // sets them as input pin
    sm_config_set_out_pins(&c, data_out_pin, 1); // seta them as outpin pin
    sm_config_set_jmp_pin(&c, jump_pin);

    sm_config_set_out_shift(&c,
    true,   // shift_right = LSB first or MSB depending on choice
    true,   // autopull
    8       // threshold = 8 bits. Should be a character level.
    );

    pio_gpio_init(pio, data_out_pin);
    pio_sm_init(pio, sm, offset, &c);
    
}
%}