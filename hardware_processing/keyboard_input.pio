.pio_version 0

.program keyboard_input

keyboard_setup:
    set pindirs, 1
    irq wait 1
    pull block
    wait 0 pin 1 ; 
    out pins, 1

.wrap_target
bitloop:
    wait 1 pin 0
    out pins, 1 ; shift another bit instantly out after waiting
    jmp !osre, bitloop
check_keyboard_select:
    jmp pin keyboard_setup
.wrap

% c-sdk {
#include "hardware/gpio.h"    
static inline void keyboard_input_program_init(PIO pio, uint sm, uint offset, uint pin_sck, uint pin_miso, uint jmp_pin)
{
    pio_sm_config c = keyboard_input_program_get_default_config(offset);
    pio_gpio_init(pio, pin_sck + 2);

    sm_config_set_out_pins(&c, pin_miso, 1); // 3 + 2 = 5 gpio 5 from hardware_processing.h
    sm_config_set_set_pins(&c, pin_miso, 1); // The above 2 are both to set the pin direction as output and output it there as well 
    sm_config_set_jmp_pin(&c, jmp_pin);
    sm_config_set_in_pins(&c, pin_sck);

    // MISO = output, SCK = input
    pio_sm_set_pindirs_with_mask(pio, sm, (1u << pin_miso), (1u << pin_sck) | (1u << pin_miso)); // in this, the miso is an output and the serial clock is an input, thats why its in the third argument and not masked in the second

// Give control of the MISO pin to the PIO, so that it can trasnmit data out of it.
    pio_gpio_init(pio, pin_miso);
    pio_gpio_init(pio, pin_sck);

// SPI is synchronous, so bypass input synchroniser to reduce input delay. This is for serial clock so can instantaenously read clock without any delays
    hw_set_bits(&pio->input_sync_bypass, 1u << pin_sck);
    hw_set_bits(&pio->input_sync_bypass, 1u << (pin_sck+1));
    sm_config_set_out_shift(&c,false,true, 8);

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}