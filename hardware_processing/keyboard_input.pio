.pio_version 0

.program keyboard_input

keyboard_setup:
    mov isr, null         ; Clear ISR and input shift counter
    mov osr, null
    set pindirs, 1
    irq wait 1
    wait 0 pin 0

.wrap_target
bitloop:
    out pins, 1
    wait 1 pin 0 
    wait 0 pin 0 ; the master samples and shifts the data 
check_keyboard_select:
    jmp !x keyboard_setup
.wrap


% c-sdk {
static inline void keyboard_input_program_init(PIO pio, uint sm, uint offset, uint clock_pin, uint jmp_pin)
{
    pio_sm_config c = keyboard_input_program_get_default_config(offset);
    pio_gpio_init(pio, clock_pin + 2);

    sm_config_set_out_pins(&c, clock_pin + 2, 1); // 3 + 2 = 5 gpio 5 from hardware_processing.h
    sm_config_set_set_pins(&c, clock_pin + 2, 1); // 
    sm_config_set_jmp_pin(&c, jmp_pin);
    sm_config_set_in_pins(&c, clock_pin);

    sm_config_set_out_shift(&c, true,true, 8);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}