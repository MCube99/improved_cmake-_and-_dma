;  //  irq wait 2
.program keyboard_input

setup:
    set x, 7
    wait 0 pin 1

bitloop:
    wait 0 pin 0
    wait 1 pin 0

    out pins, 1

    jmp x-- bitloop

wait_csn_release:
    jmp pin setup
    jmp wait_csn_release

% c-sdk {
static inline void keyboard_input_program_init(PIO pio, uint sm, uint offset, uint pin) {
    pio_sm_config c = keyboard_input_program_get_default_config(offset);

    pio_sm_set_consecutive_pindirs(pio, sm,pin, 2, false); //sets input pin. This means the clock pin and the csn pin
    pio_sm_set_consecutive_pindirs(pio, sm,pin+2, 1, true); // sets output pin. This means the transmission pin

    sm_config_set_in_pins(&c, pin);   // PICO_DEFAULT_SPI_SCK_PIN  ((PICO_DEFAULT_SPI_RX_PIN) + 1)   //3  
    sm_config_set_jmp_pin(&c, pin+1); //  PICO_DEFAULT_SPI_CSN_PIN   ((PICO_DEFAULT_SPI_RX_PIN) + 2)
    sm_config_set_out_pins(&c,pin+2, 1); // PICO_DEFAULT_SPI_TX_PIN  ((PICO_DEFAULT_SPI_RX_PIN) + 3)

    sm_config_set_out_shift(&c,
    true,   // shift_right = LSB first or MSB depending on choice
    true,   // autopull
    8       // threshold = 8 bits. Should be a character level.
    );

    pio_gpio_init(pio, pin+2);
     sm_config_set_clkdiv(&c, 65535.f);   
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
// pin is the serial clock pin and all other pins will be in reference to it. See hardware_processing.h for details
    
}
%}