.pio_version 0

.program keyboard_input

keyboard_setup:
    irq wait 1

.wrap_target
keyboard_processing:
    wait 0 gpio 4

bitloop:
    out pins, 1
    wait 0 pin 1
    wait 1 pin 1
    jmp !x keyboard_setup
    jmp !osre bitloop
.wrap


% c-sdk {
static inline void keyboard_input_program_init(PIO pio, uint sm, uint offset, uint data_pin, uint jmp_pin)
{
    pio_sm_config c = keyboard_input_program_get_default_config(offset);

    sm_config_set_out_pins(&c, data_pin, 1);
    sm_config_set_set_pins(&c, data_pin, 1);

    pio_gpio_init(pio, data_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, data_pin, 1, true);

    sm_config_set_jmp_pin(&c, jmp_pin);

    sm_config_set_out_shift(&c, true, true, 8);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}